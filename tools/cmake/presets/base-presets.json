{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cmake",
      "hidden": true,
      "warnings": {
        "dev": false,
        "deprecated": true,
        "uninitialized": false,
        "unusedCli": true,
        "systemVars": false
      },
      "errors": {
        "dev": false,
        "deprecated": false
      }
    },
    {
      "name": "cmake-experimental",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD": "f35a9ac6-8463-4d38-8eec-5d6008153e7d",
        "CMAKE_EXPERIMENTAL_EXPORT_BUILD_DATABASE": "70ef007e-b743-492d-9407-e35eeac03a40",
        "CMAKE_EXPERIMENTAL_EXPORT_PACKAGE_DEPENDENCIES": "1942b4fa-b2c5-4546-9385-83f254070067",
        "CMAKE_EXPERIMENTAL_FIND_CPS_PACKAGES": "e82e467b-f997-4464-8ace-b00808fff261",
        "CMAKE_EXPERIMENTAL_MAPPED_PACKAGE_INFO": "ababa1b5-7099-495f-a9cd-e22d38f274f2"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/external/vcpkg"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALL_OPTIONS": "--allow-unsupported",
        "VCPKG_BOOTSTRAP_OPTIONS": "-disableMetrics",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_installed"
      }
    },
    {
      "name": "project-config",
      "hidden": true,
      "inherits": [
        "cmake",
        "cmake-experimental",
        "vcpkg"
      ],
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_BUILD_DATABASE": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_EXPORT_SARIF": true,
        "CMAKE_COLOR_DIAGNOSTICS": true,
        "CMAKE_CXX_MODULE_STD": true,
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_CXX_STANDARD_REQUIRED": true,
        "CMAKE_CXX_EXTENSIONS": false,
        "CMAKE_MODULE_PATH": "${sourceDir}/tools/cmake/modules;"
      }
    },
    {
      "name": "cppcheck",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_CPPCHECK": "cppcheck;--inline-suppr"
      }
    },
    {
      "name": "clang-tidy",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--header-filter=^${sourceDir}/"
      }
    }
  ]
}
