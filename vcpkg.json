{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "argparse",
    "directx-dxc",
    "directxmath",
    "efsw",
    "glaze",
    "imgui",
    {
      "name": "sdl2",
      "features": [
        "vulkan"
      ]
    },
    "quill",
    "shader-slang",
    "vk-bootstrap",
    "vulkan",
    "vulkan-headers",
    "vulkan-memory-allocator",
    "vulkan-memory-allocator-hpp",
    "vulkan-validationlayers"
  ],
  "overrides": [],
  "vcpkg-configuration": {
    "overlay-ports": [
      "tools/vcpkg-overlays/ports"
    ],
    "overlay-triplets": [
      "tools/vcpkg-overlays/triplets"
    ]
  }
}
